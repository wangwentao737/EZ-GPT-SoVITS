        ["Textbox", "string"],
        ["Textbox", "string"],
        ["Dropdown", "string"],
        ["Dropdown", "string"],
        ["Slider", "number"],
        ["Slider", "number"],
        ["Slider", "number"],
        ["Slider", "number"],
        ["Checkbox", "boolean"],
        ["Checkbox", "boolean"],
        ["Radio", "string"]
