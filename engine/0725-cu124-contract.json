    "change_tts_inference_1": {
      "inputs": [
        ["bert_path", "Textbox", "string", "预训练中文BERT模型路径"],
        ["cnhubert_base_path", "Textbox", "string", "预训练SSL模型路径"],
        ["gpu_number", "Textbox", "string", "GPU卡号,只能填1个整数"],
